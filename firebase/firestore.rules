rules_version = '2';
// As primeiras regras reais do projeto (T03; tasks/painel/proposta.md, §5). O banco ainda
// não existe (D2, 24/09); nada fora do modelo canônico tem bloco, então tudo o mais é negado.
//
// Autorização: users/{uid} é a fonte de role, agencyId e active. Ninguém muda os
// próprios; só platform_admin muda os de qualquer um.
service cloud.firestore {
  match /databases/{db}/documents {

    // ── quem é quem ──
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(db)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function active() {
      return signedIn() && exists(userPath(request.auth.uid)) && me().active == true;
    }
    function role() { return me().role; }
    function isAdmin() { return active() && role() == 'platform_admin'; }
    function isStaff() { return active() && role() in ['platform_admin', 'operator']; }
    function inAgency(a) {
      return active() && role() in ['agency_manager', 'agent'] && me().agencyId == a;
    }
    function isManager(a) { return inAgency(a) && role() == 'agency_manager'; }

    // ── escrita ──
    function d() { return request.resource.data; }
    function diffKeys() { return d().diff(resource.data).affectedKeys(); }
    function changed(f) { return diffKeys().hasAny([f]); }
    function keeps(fs) { return !diffKeys().hasAny(fs); }
    function changesOnly(fs) { return diffKeys().hasOnly(fs); }
    function stamped() { return d().updatedAt == request.time; }
    function born() { return d().createdAt == request.time && stamped(); }

    // O AuditLog nasce no MESMO batch: mesmo request.time, mesmo autor, mesma entidade.
    // Reaproveitar um log antigo falha no timestamp.
    function auditedAs(id, action) {
      let log = getAfter(/databases/$(db)/documents/auditLogs/$(d().lastAuditId)).data;
      return log.entityId == id && log.action == action
        && log.userId == request.auth.uid && log.timestamp == request.time;
    }

    // Papel interno não tem agência; papel de imobiliária tem uma que existe.
    function validMembership(u) {
      return (u.role in ['agency_manager', 'agent'] && u.agencyId is string
                && exists(/databases/$(db)/documents/agencies/$(u.agencyId)))
          || (u.role in ['platform_admin', 'operator'] && !('agencyId' in u));
    }

    // ── agencies ──
    match /agencies/{agencyId} {
      allow read: if isStaff() || inAgency(agencyId);
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;                          // desativar: active = false
    }

    // ── users ──
    function invite() {
      return get(/databases/$(db)/documents/invites/$(request.auth.token.email)).data;
    }
    // invites/ guarda só convites PENDENTES: o aceite consome o convite. O convidado apaga o PRÓPRIO
    // convite, e só no batch em que nasce o users/{uid} dele, com o mesmo e-mail. Quem já existe
    // (inclusive o próprio convidado depois do aceite) não ganha poder nenhum sobre convites.
    function aceitandoConvite(email) {
      return signedIn() && request.auth.token.email == email
        && request.auth.token.email_verified == true
        && !exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(db)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.email == email;
    }
    match /users/{uid} {
      allow read: if isStaff()
        || (signedIn() && request.auth.uid == uid)
        || isManager(resource.data.agencyId);

      // Só nasce de convite: próprio uid, e-mail verificado, papel e agência do convite.
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && d().email == request.auth.token.email
        && d().role == invite().role
        && d().get('agencyId', null) == invite().get('agencyId', null)
        && d().active == true && born()
        && d().keys().hasOnly(['name', 'email', 'role', 'agencyId', 'active',
                               'createdAt', 'updatedAt'])
        // e o convite sai no mesmo batch (invite() acima lê o de antes do batch)
        && !existsAfter(/databases/$(db)/documents/invites/$(request.auth.token.email));

      allow update: if stamped() && keeps(['email', 'createdAt'])
        && ((isAdmin() && validMembership(d()))
          || (signedIn() && request.auth.uid == uid && changesOnly(['name', 'updatedAt'])));
      allow delete: if false;
    }

    // ── invites ──
    match /invites/{email} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.token.email == email
            && request.auth.token.email_verified == true);
      allow create, update: if isAdmin() && d().email == email && validMembership(d());
      allow delete: if isAdmin() || aceitandoConvite(email);
    }

    // ── properties ──
    function pubFields() {
      return ['tourUrl', 'maqueteUrl', 'publicUrl', 'publishedBuild', 'previousBuild',
              'publishedRequestId', 'previousRequestId', 'publishedAt', 'lastPublicationId'];
    }
    // O que uma reversão pode mudar. Todo outro campo de publicação (URLs, ponteiros) fica igual.
    function rollbackFields() {
      return ['publishedBuild', 'previousBuild', 'publishedRequestId', 'previousRequestId',
              'publishedAt', 'lastPublicationId'];
    }
    // Publicar e reverter nascem com um registro em publications no MESMO batch: mesmo
    // autor, mesmo request.time, mesmo imóvel, mesmo build. Ele é o histórico e a auditoria.
    function publishedAs(pid, action) {
      let p = getAfter(/databases/$(db)/documents/publications/$(d().lastPublicationId)).data;
      return p.propertyId == pid && p.action == action && p.build == d().publishedBuild
        && p.publishedBy == request.auth.uid && p.publishedAt == request.time;
    }
    // O build que vai ao ar é o aprovado de um pedido DESTE imóvel, publicado no mesmo batch.
    function publishedFromApproved(pid) {
      let r = getAfter(/databases/$(db)/documents/requests/$(d().publishedRequestId)).data;
      return r.propertyId == pid && r.status == 'published'
        && r.approvedBuild == d().publishedBuild;
    }
    // No ar e anterior andam em PARES (build, pedido que o aprovou): publicar empurra o par atual
    // para "anterior"; reverter troca os dois pares. Assim publishedRequestId é sempre o pedido
    // que aprovou o publishedBuild, inclusive depois de reverter.
    function publicationOk(pid) {
      return (publishedAs(pid, 'publish') && d().publishedAt == request.time
                && d().get('previousBuild', null) == resource.data.get('publishedBuild', null)
                && d().get('previousRequestId', null) == resource.data.get('publishedRequestId', null)
                && publishedFromApproved(pid))
          || (publishedAs(pid, 'rollback') && d().publishedAt == request.time
                && d().publishedBuild == resource.data.previousBuild
                && d().previousBuild == resource.data.publishedBuild
                && d().publishedRequestId == resource.data.previousRequestId
                && d().previousRequestId == resource.data.publishedRequestId
                && !diffKeys().hasAny(pubFields().removeAll(rollbackFields())))
          || (auditedAs(pid, 'urls')
                && keeps(['publishedBuild', 'previousBuild', 'publishedRequestId', 'previousRequestId',
                          'publishedAt', 'lastPublicationId']));
    }
    match /properties/{pid} {
      allow read: if isStaff() || inAgency(resource.data.agencyId);
      allow create: if isStaff() && born() && !d().keys().hasAny(pubFields())
        && exists(/databases/$(db)/documents/agencies/$(d().agencyId));
      allow update: if stamped() && keeps(['createdAt'])
        && ((isAdmin() && (!diffKeys().hasAny(pubFields()) || publicationOk(pid)))
          || (isStaff() && keeps(['agencyId']) && !diffKeys().hasAny(pubFields()))
          || (isManager(resource.data.agencyId)
              && changesOnly(['assignedAgentId', 'updatedAt'])
              && get(userPath(d().assignedAgentId)).data.agencyId == resource.data.agencyId));
      allow delete: if false;                          // arquivar: status = archived
    }

    // Snapshots M1-D: criação somente pela API autenticada + gate Python M1-0.
    // Admin SDK ignora rules: autorização é repetida na transação da API.
    match /propertyReadings/{id} {
      allow read: if isStaff() || (inAgency(resource.data.agencyId)
        && get(/databases/$(db)/documents/properties/$(resource.data.propertyId)).data.agencyId
             == resource.data.agencyId);
      allow create, update, delete: if false;
    }
    match /propertyReadingCounters/{id} {
      allow read, write: if false;
    }

    // ── requests ──
    function from() { return resource.data.status; }
    function to() { return d().status; }

    // sha256 do manifest.json servido no preview: a identidade exata do artefato aprovado
    // (build once, promote the exact artifact). matches() casa a string inteira.
    function isSha256(v) { return v is string && v.matches('[0-9a-f]{64}'); }
    function productionModeOk() {
      return 'productionMode' in d() && d().productionMode in ['leve', 'premium'];
    }

    // Ninguém além do gerente escreve a aprovação. Publicar exige o artefato aprovado: o build
    // e o manifest; uma aprovação sem a identidade do manifest não publica.
    function staffEdit() {
      return keeps(['approvedBuild', 'approvedManifestSha256', 'approvedBy', 'approvedAt'])
        && ((isAdmin() && (to() != 'published'
                           || (from() in ['approved', 'published']
                               && resource.data.approvedBuild == resource.data.preview.build
                               && isSha256(resource.data.get('approvedManifestSha256', null))
                               && resource.data.approvedManifestSha256
                                    == resource.data.preview.get('manifestSha256', null))))
          || (isStaff() && !(to() in ['approved', 'published'])));
    }
    function managerDecision() {
      return isManager(resource.data.agencyId) && from() == 'agency_review'
        && ((to() == 'approved'
              && changesOnly(['status', 'approvedBuild', 'approvedManifestSha256', 'approvedBy',
                              'approvedAt', 'updatedAt', 'lastAuditId'])
              && d().approvedBuild == resource.data.preview.build
              && isSha256(d().get('approvedManifestSha256', null))
              && d().approvedManifestSha256 == resource.data.preview.get('manifestSha256', null)
              && d().approvedBy == request.auth.uid
              && d().approvedAt == request.time)
          || (to() == 'production' && changesOnly(['status', 'updatedAt', 'lastAuditId'])));
    }
    function requesterEdit() {
      return inAgency(resource.data.agencyId)
        && (role() == 'agency_manager' || request.auth.uid == resource.data.requestedBy)
        && from() in ['submitted', 'waiting_materials']
        && to() in [from(), 'submitted', 'cancelled']
        && changesOnly(['title', 'notes', 'listingUrl', 'status', 'updatedAt', 'lastAuditId']);
    }

    match /requests/{rid} {
      allow read: if isStaff() || inAgency(resource.data.agencyId);

      allow create: if (isStaff() || inAgency(d().agencyId))
        && d().requestedBy == request.auth.uid
        && d().status == 'submitted' && born()
        && productionModeOk()
        && (!('propertyId' in d())
            || get(/databases/$(db)/documents/properties/$(d().propertyId)).data.agencyId
                 == d().agencyId)
        && d().keys().hasOnly(['agencyId', 'requestedBy', 'propertyId', 'listingUrl', 'title',
                               'productionMode', 'status', 'priority', 'notes', 'createdAt', 'updatedAt']);

      allow update: if keeps(['agencyId', 'requestedBy', 'productionMode', 'createdAt']) && stamped()
        && (!changed('status') || auditedAs(rid, 'status:' + to()))
        // trocar o preview tira o pedido de approved: a aprovação é de um build
        && (!changed('preview') || !(to() in ['approved', 'published']))
        // o imóvel vinculado é sempre da imobiliária do pedido, na criação e em toda troca
        && (!changed('propertyId') || !('propertyId' in d())
            || get(/databases/$(db)/documents/properties/$(d().propertyId)).data.agencyId
                 == resource.data.agencyId)
        // o primeiro build de revisão amarra o pedido à unidade: depois dele, propertyId não muda
        // (para ninguém, nem platform_admin), e o preview só é trocado, nunca removido
        && (!changed('propertyId') || !('preview' in resource.data))
        && (!changed('preview') || 'preview' in d())
        // todo preview que entra traz a identidade exata do manifest que foi servido
        && (!changed('preview') || isSha256(d().preview.get('manifestSha256', null)))
        && (to() != 'agency_review'
            || (d().preview.build is string && isSha256(d().preview.get('manifestSha256', null))))
        && (staffEdit() || managerDecision() || requesterEdit());
      allow delete: if false;

      match /internal/{doc} {
        allow read, write: if isStaff();
      }
    }

    // ── requestAssets ──
    match /requestAssets/{aid} {
      allow read: if isStaff() || inAgency(resource.data.agencyId);
      allow create: if (isStaff() || inAgency(d().agencyId))
        && d().uploadedBy == request.auth.uid && d().createdAt == request.time
        && get(/databases/$(db)/documents/requests/$(d().requestId)).data.agencyId
             == d().agencyId
        && d().storagePath == 'request-assets/' + d().agencyId + '/' + d().requestId
                              + '/' + d().filename
        && d().type in ['photo', 'video', 'floorplan', 'document', 'reference', 'other']
        && d().keys().hasOnly(['requestId', 'agencyId', 'type', 'filename', 'storagePath',
                               'uploadedBy', 'createdAt']);
      allow update: if false;
      allow delete: if isStaff();
    }

    // ── auditLogs (só cresce) ──
    match /auditLogs/{id} {
      allow read: if isStaff()
        || (inAgency(resource.data.agencyId) && resource.data.visibility == 'agency');
      allow create: if active()
        && d().userId == request.auth.uid && d().timestamp == request.time
        && d().visibility in ['internal', 'agency']
        && (isStaff() || (inAgency(d().agencyId) && d().visibility == 'agency'));
      allow update, delete: if false;
    }

    // ── publications (histórico de publicar/reverter; só cresce) ──
    // Só nasce junto com a mudança do imóvel que aponta para ela (lastPublicationId).
    function publicationBorn(pubId) {
      let p = getAfter(/databases/$(db)/documents/properties/$(d().propertyId)).data;
      return p.lastPublicationId == pubId && p.agencyId == d().agencyId
        && p.publishedBuild == d().build
        && d().get('requestId', null) == p.get('publishedRequestId', null);   // o histórico diz o mesmo pedido
    }
    match /publications/{pubId} {
      allow read: if isStaff() || inAgency(resource.data.agencyId);
      allow create: if isAdmin()
        && d().publishedBy == request.auth.uid && d().publishedAt == request.time
        && d().action in ['publish', 'rollback'] && publicationBorn(pubId)
        && d().keys().hasOnly(['propertyId', 'agencyId', 'requestId', 'action', 'build',
                               'previousBuild', 'tourUrl', 'maqueteUrl', 'publishedBy',
                               'publishedAt']);
      allow update, delete: if false;
    }

    // ── buildJobs (Fase 2) ──
    // Só tools/buildjob.mjs escreve, com o Admin SDK, que não passa por estas regras.
    match /buildJobs/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
