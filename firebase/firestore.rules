rules_version = '2';
// As primeiras regras reais do projeto (T03; tasks/painel/proposta.md, §5). O banco ainda
// não existe (D2, 24/09); nada fora do modelo canônico tem bloco, então tudo o mais é negado.
//
// Autorização: users/{uid} é a fonte de role, agencyId e active. Ninguém muda os
// próprios; só platform_admin muda os de qualquer um.
service cloud.firestore {
  match /databases/{db}/documents {

    // ── quem é quem ──
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(db)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function active() {
      return signedIn() && exists(userPath(request.auth.uid)) && me().active == true;
    }
    function role() { return me().role; }
    function isAdmin() { return active() && role() == 'platform_admin'; }
    function isStaff() { return active() && role() in ['platform_admin', 'operator']; }
    // O robô do M2 (tasks/painel/m2-worker.md §6): o usuário users/worker, platform_admin. As regras de
    // um clique valem para ele; onde aparece isWorker(), elas o prendem ao que a política deixa.
    function isWorker() { return signedIn() && request.auth.uid == 'worker'; }
    function inAgency(a) {
      return active() && role() in ['agency_manager', 'agent'] && me().agencyId == a;
    }
    function isManager(a) { return inAgency(a) && role() == 'agency_manager'; }

    // ── escrita ──
    function d() { return request.resource.data; }
    function diffKeys() { return d().diff(resource.data).affectedKeys(); }
    function changed(f) { return diffKeys().hasAny([f]); }
    function keeps(fs) { return !diffKeys().hasAny(fs); }
    function changesOnly(fs) { return diffKeys().hasOnly(fs); }
    function stamped() { return d().updatedAt == request.time; }
    function born() { return d().createdAt == request.time && stamped(); }

    // O AuditLog nasce no MESMO batch: mesmo request.time, mesmo autor, mesma entidade.
    // Reaproveitar um log antigo falha no timestamp.
    function auditedAs(id, action) {
      let log = getAfter(/databases/$(db)/documents/auditLogs/$(d().lastAuditId)).data;
      return log.entityId == id && log.action == action
        && log.userId == request.auth.uid && log.timestamp == request.time;
    }

    // Papel interno não tem agência; papel de imobiliária tem uma que existe.
    function validMembership(u) {
      return (u.role in ['agency_manager', 'agent'] && u.agencyId is string
                && exists(/databases/$(db)/documents/agencies/$(u.agencyId)))
          || (u.role in ['platform_admin', 'operator'] && !('agencyId' in u));
    }

    // Contato público do usuário: só o WhatsApp, E.164 sem "+", o mesmo padrão do servidor do link.
    function contatoOk(u) {
      return !('publicContact' in u)
        || (u.publicContact is map && u.publicContact.keys().hasOnly(['whatsapp'])
            && (u.publicContact.get('whatsapp', null) == null
                || (u.publicContact.whatsapp is string && u.publicContact.whatsapp.matches('[1-9][0-9]{7,14}'))));
    }

    // ── agencies ──
    // kind: imobiliaria | construtora. Ausente = imobiliária (contas anteriores ao campo).
    match /agencies/{agencyId} {
      allow read: if isStaff() || inAgency(agencyId);
      allow create, update: if isAdmin() && !isWorker() && stamped()
        && (!('kind' in d()) || d().kind in ['imobiliaria', 'construtora']);
      allow delete: if false;                          // desativar: active = false
    }

    // ── users ──
    function invite() {
      return get(/databases/$(db)/documents/invites/$(request.auth.token.email)).data;
    }
    // invites/ guarda só convites PENDENTES: o aceite consome o convite. O convidado apaga o PRÓPRIO
    // convite, e só no batch em que nasce o users/{uid} dele, com o mesmo e-mail. Quem já existe
    // (inclusive o próprio convidado depois do aceite) não ganha poder nenhum sobre convites.
    function aceitandoConvite(email) {
      return signedIn() && request.auth.token.email == email
        && request.auth.token.email_verified == true
        && !exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(db)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.email == email;
    }
    match /users/{uid} {
      allow read: if isStaff()
        || (signedIn() && request.auth.uid == uid)
        || isManager(resource.data.agencyId);

      // Só nasce de convite: próprio uid, e-mail verificado, papel e agência do convite.
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && d().email == request.auth.token.email
        && d().role == invite().role
        && d().get('agencyId', null) == invite().get('agencyId', null)
        && d().active == true && born()
        && d().keys().hasOnly(['name', 'email', 'role', 'agencyId', 'active',
                               'createdAt', 'updatedAt'])
        // e o convite sai no mesmo batch (invite() acima lê o de antes do batch)
        && !existsAfter(/databases/$(db)/documents/invites/$(request.auth.token.email));

      allow update: if stamped() && keeps(['email', 'createdAt']) && contatoOk(d())
        && ((isAdmin() && !isWorker() && validMembership(d()))
          || (signedIn() && request.auth.uid == uid && changesOnly(['name', 'publicContact', 'updatedAt'])));
      allow delete: if false;
    }

    // ── invites ──
    match /invites/{email} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.token.email == email
            && request.auth.token.email_verified == true);
      allow create, update: if isAdmin() && !isWorker() && d().email == email && validMembership(d());
      allow delete: if (isAdmin() && !isWorker()) || aceitandoConvite(email);
    }

    // ── properties ──
    function pubFields() {
      return ['tourUrl', 'maqueteUrl', 'publicUrl', 'publishedBuild', 'previousBuild',
              'publishedRequestId', 'previousRequestId', 'publishedAt', 'lastPublicationId'];
    }
    // O que uma reversão pode mudar. Todo outro campo de publicação (URLs, ponteiros) fica igual.
    function rollbackFields() {
      return ['publishedBuild', 'previousBuild', 'publishedRequestId', 'previousRequestId',
              'publishedAt', 'lastPublicationId'];
    }
    // Publicar e reverter nascem com um registro em publications no MESMO batch: mesmo
    // autor, mesmo request.time, mesmo imóvel, mesmo build. Ele é o histórico e a auditoria.
    function publishedAs(pid, action) {
      let p = getAfter(/databases/$(db)/documents/publications/$(d().lastPublicationId)).data;
      return p.propertyId == pid && p.action == action && p.build == d().publishedBuild
        && p.publishedBy == request.auth.uid && p.publishedAt == request.time;
    }
    // O build que vai ao ar é o aprovado de um pedido DESTE imóvel, publicado no mesmo batch.
    function publishedFromApproved(pid) {
      let r = getAfter(/databases/$(db)/documents/requests/$(d().publishedRequestId)).data;
      return r.propertyId == pid && r.status == 'published'
        && r.approvedBuild == d().publishedBuild;
    }
    // No ar e anterior andam em PARES (build, pedido que o aprovou): publicar empurra o par atual
    // para "anterior"; reverter troca os dois pares. Assim publishedRequestId é sempre o pedido
    // que aprovou o publishedBuild, inclusive depois de reverter.
    function publicationOk(pid) {
      return (publishedAs(pid, 'publish') && d().publishedAt == request.time
                && d().get('previousBuild', null) == resource.data.get('publishedBuild', null)
                && d().get('previousRequestId', null) == resource.data.get('publishedRequestId', null)
                && publishedFromApproved(pid))
          || (publishedAs(pid, 'rollback') && d().publishedAt == request.time
                && d().publishedBuild == resource.data.previousBuild
                && d().previousBuild == resource.data.publishedBuild
                && d().publishedRequestId == resource.data.previousRequestId
                && d().previousRequestId == resource.data.publishedRequestId
                && !diffKeys().hasAny(pubFields().removeAll(rollbackFields())))
          || (auditedAs(pid, 'urls')
                && keeps(['publishedBuild', 'previousBuild', 'publishedRequestId', 'previousRequestId',
                          'publishedAt', 'lastPublicationId']));
    }
    match /properties/{pid} {
      allow read: if isStaff() || inAgency(resource.data.agencyId);
      allow create: if isStaff() && !isWorker() && born() && !d().keys().hasAny(pubFields())
        && exists(/databases/$(db)/documents/agencies/$(d().agencyId));
      // o robô só mexe no imóvel ao publicar: nem URLs, nem reversão, nem cadastro
      allow update: if stamped() && keeps(['createdAt'])
        && (!isWorker() || publishedAs(pid, 'publish'))
        && ((isAdmin() && (!diffKeys().hasAny(pubFields()) || publicationOk(pid)))
          || (isStaff() && keeps(['agencyId']) && !diffKeys().hasAny(pubFields()))
          || (isManager(resource.data.agencyId)
              && changesOnly(['assignedAgentId', 'updatedAt'])
              && get(userPath(d().assignedAgentId)).data.agencyId == resource.data.agencyId));
      allow delete: if false;                          // arquivar: status = archived
    }

    // ── vitrine (pública) ──
    // vitrine/{slug}: no ar ou fora, preço e situação do imóvel, lidos pela página pública
    // (pipeline/vitrine_ao_vivo.js) sem build novo. A chave é o slug público (pipelineUnitId);
    // o imóvel que o documento aponta tem de ter esse slug, e grava a equipe ou o gerente dele.
    function vitrineDe() { return get(/databases/$(db)/documents/properties/$(d().propertyId)).data; }
    match /vitrine/{slug} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if stamped()
        && d().keys().hasOnly(['propertyId', 'online', 'situacao', 'precoCentavos', 'updatedAt'])
        && d().keys().hasAll(['propertyId', 'online', 'situacao', 'precoCentavos', 'updatedAt'])
        && d().propertyId is string && (resource == null || d().propertyId == resource.data.propertyId)
        && vitrineDe().pipelineUnitId == slug
        && (isStaff() || isManager(vitrineDe().agencyId))
        && d().online is bool
        && d().situacao in ['disponivel', 'reservado', 'vendido', 'alugado']
        && (d().precoCentavos == null
            || (d().precoCentavos is int && d().precoCentavos >= 0 && d().precoCentavos <= 9007199254740991));
      allow delete: if false;
    }

    // Estoque público do LIV: somente dados de oferta. properties/users e o histórico
    // continuam privados. A autorização consulta o imóvel atual, nunca a agência enviada.
    function salesProperty(pid) { return get(/databases/$(db)/documents/properties/$(pid)).data; }
    // Estoque é módulo de construtora: nem a equipe escreve no de imóvel de imobiliária.
    function salesConstrutora(pid) {
      return get(/databases/$(db)/documents/agencies/$(salesProperty(pid).agencyId)).data.get('kind', 'imobiliaria') == 'construtora';
    }
    function salesEdit(pid) { return (isStaff() || isManager(salesProperty(pid).agencyId)) && salesConstrutora(pid); }
    function salesRead(pid) { return isStaff() || inAgency(salesProperty(pid).agencyId); }
    function salesPublic(pid) {
      return get(/databases/$(db)/documents/salesInventory/$(pid)).data.publicEnabled == true
        && salesProperty(pid).status == 'active';
    }
    function salesText(v, n) { return v == null || (v is string && v.size() > 0 && v.size() <= n); }
    function salesNumber(v, max, integral) {
      return v == null || (v is number && v >= 0 && v <= max && (!integral || v is int));
    }
    function salesInfo(v) {
      return v is map && v.keys().hasAll(['priceCents', 'areaM2', 'bedrooms', 'bathrooms', 'parking', 'description', 'conditions'])
        && v.keys().hasOnly(['priceCents', 'areaM2', 'bedrooms', 'bathrooms', 'parking', 'description', 'conditions'])
        && salesNumber(v.priceCents, 9007199254740991, true) && salesNumber(v.areaM2, 10000, false)
        && salesNumber(v.bedrooms, 100, true) && salesNumber(v.bathrooms, 100, true)
        && salesText(v.parking, 200) && salesText(v.description, 2000) && salesText(v.conditions, 2000);
    }
    function salesEmpty(v) {
      return v.priceCents == null && v.areaM2 == null && v.bedrooms == null && v.bathrooms == null
        && v.parking == null && v.description == null && v.conditions == null;
    }
    function salesStamp() {
      return stamped() && d().revision is int && d().revision >= 1
        && d().lastChangeId is string && d().lastChangeId.matches('[A-Za-z0-9]{20}');
    }
    function salesAudit(pid, kind, key) {
      let log = getAfter(/databases/$(db)/documents/salesInventory/$(pid)/history/$(d().lastChangeId)).data;
      return log.kind == kind && log.key == key && log.revision == d().revision
        && log.actor == request.auth.uid && log.timestamp == request.time && log.snapshot == d();
    }
    function salesInitializing(pid) {
      let p = getAfter(/databases/$(db)/documents/salesInventory/$(pid)).data;
      return !exists(/databases/$(db)/documents/salesInventory/$(pid)) && p.revision == 1
        && p.publicEnabled == false && p.updatedAt == request.time && d().lastChangeId == p.lastChangeId;
    }
    function salesSettings() {
      return d().keys().hasAll(['schema', 'bookSHA256', 'model', 'total', 'title', 'publicEnabled', 'revision', 'updatedAt', 'lastChangeId'])
        && d().keys().hasOnly(['schema', 'bookSHA256', 'model', 'total', 'title', 'publicEnabled', 'revision', 'updatedAt', 'lastChangeId'])
        && d().schema == 'liv-sales-v1' && d().model == 'liv-ipanema' && d().total == 170
        && d().bookSHA256 == 'c7dae676c82eab758370e386cea7fe6bd31dded9fa436eb53ebdfe70be7bb50b'
        && d().title is string && salesText(d().title, 200) && d().publicEnabled is bool && salesStamp();
    }
    function salesUnit(key) {
      let floors = ['00','01','02','03','04','05','06','07','08','09','10','11','12','13','14','15','16'];
      let finals = ['01','02','03','04','05','06','07','08','09','10'];
      return d().keys().hasAll(['id','floor','final','technicalId','commercialNumber','availability','profileId','overrides','revision','updatedAt','lastChangeId'])
        && d().keys().hasOnly(['id','floor','final','technicalId','commercialNumber','availability','profileId','overrides','revision','updatedAt','lastChangeId'])
        && d().floor is int && d().floor >= 0 && d().floor <= 16 && d().final is int && d().final >= 1 && d().final <= 10
        && key == 'p' + floors[d().floor] + '-f' + finals[d().final - 1] && d().id == key
        && d().technicalId == 'liv-ipanema/pavimento-modelo-' + floors[d().floor] + '/final-' + finals[d().final - 1]
        && salesText(d().commercialNumber, 100)
        && (d().commercialNumber == null || d().commercialNumber.matches('[A-Z0-9 _-]{1,100}'))
        && d().availability in ['nao_informada','disponivel','reservada','vendida','bloqueada']
        && (d().profileId == null || d().profileId in ['canto','meio']) && salesInfo(d().overrides) && salesStamp();
    }
    function salesProfile(key) {
      return key in ['canto','meio'] && d().id == key && salesInfo(d().info) && salesStamp()
        && d().keys().hasAll(['id','info','revision','updatedAt','lastChangeId'])
        && d().keys().hasOnly(['id','info','revision','updatedAt','lastChangeId']);
    }
    match /salesInventory/{pid} {
      // Endereço público de um estoque específico; sem enumerar cadastros de terceiros.
      allow get: if true;
      allow list: if isStaff();
      allow create: if salesEdit(pid) && exists(/databases/$(db)/documents/properties/$(pid))
        && salesSettings() && d().publicEnabled == false && d().revision == 1 && salesAudit(pid, 'settings', 'settings');
      allow update: if salesEdit(pid) && salesSettings() && d().revision == resource.data.revision + 1
        && changesOnly(['title','publicEnabled','revision','updatedAt','lastChangeId']) && salesAudit(pid, 'settings', 'settings');
      allow delete: if false;
      match /units/{key} {
        allow read: if salesRead(pid) || salesPublic(pid);
        allow create: if salesEdit(pid) && salesInitializing(pid) && salesUnit(key) && d().revision == 1
          && d().commercialNumber == null && d().availability == 'nao_informada' && d().profileId == null && salesEmpty(d().overrides);
        allow update: if salesEdit(pid) && salesUnit(key) && d().revision == resource.data.revision + 1
          && changesOnly(['commercialNumber','availability','profileId','overrides','revision','updatedAt','lastChangeId'])
          && (d().commercialNumber == null || getAfter(/databases/$(db)/documents/salesInventory/$(pid)/numbers/$(d().commercialNumber)).data.unitKey == key)
          && (!changed('commercialNumber') || resource.data.commercialNumber == null
               || !existsAfter(/databases/$(db)/documents/salesInventory/$(pid)/numbers/$(resource.data.commercialNumber)))
          && salesAudit(pid, 'units', key);
        allow delete: if false;
      }
      match /numbers/{number} {
        allow read: if salesRead(pid);
        allow create, update: if salesEdit(pid) && number.matches('[A-Z0-9 _-]{1,100}')
          && d().keys().hasOnly(['unitKey']) && d().unitKey is string
          && getAfter(/databases/$(db)/documents/salesInventory/$(pid)/units/$(d().unitKey)).data.commercialNumber == number
          && getAfter(/databases/$(db)/documents/salesInventory/$(pid)/units/$(d().unitKey)).data.updatedAt == request.time
          && (!exists(/databases/$(db)/documents/salesInventory/$(pid)/numbers/$(number)) || resource.data.unitKey == d().unitKey);
        allow delete: if salesEdit(pid)
          && getAfter(/databases/$(db)/documents/salesInventory/$(pid)/units/$(resource.data.unitKey)).data.commercialNumber != number
          && getAfter(/databases/$(db)/documents/salesInventory/$(pid)/units/$(resource.data.unitKey)).data.updatedAt == request.time;
      }
      match /profiles/{key} {
        allow read: if salesRead(pid) || salesPublic(pid);
        allow create: if salesEdit(pid) && salesInitializing(pid) && salesProfile(key) && d().revision == 1 && salesEmpty(d().info);
        allow update: if salesEdit(pid) && salesProfile(key) && d().revision == resource.data.revision + 1
          && changesOnly(['info','revision','updatedAt','lastChangeId']) && salesAudit(pid, 'profiles', key);
        allow delete: if false;
      }
      match /history/{changeId} {
        allow read: if salesRead(pid);
        allow create: if salesEdit(pid) && d().actor == request.auth.uid && d().timestamp == request.time
          && d().keys().hasAll(['kind','key','revision','actor','timestamp','snapshot'])
          && d().keys().hasOnly(['kind','key','revision','actor','timestamp','snapshot'])
          && d().kind in ['settings','units','profiles'] && d().snapshot.revision == d().revision
          && d().snapshot.lastChangeId == changeId && d().snapshot.updatedAt == request.time
          && ((d().kind == 'settings' && d().key == 'settings'
               && getAfter(/databases/$(db)/documents/salesInventory/$(pid)).data == d().snapshot)
            || (d().kind in ['units','profiles'] && d().key is string
               && getAfter(/databases/$(db)/documents/salesInventory/$(pid)/$(d().kind)/$(d().key)).data == d().snapshot));
        allow update, delete: if false;
      }
    }

    // Snapshots M1-D: criação somente pela API autenticada + gate Python M1-0.
    // Admin SDK ignora rules: autorização é repetida na transação da API.
    match /propertyReadings/{id} {
      allow read: if isStaff() || (inAgency(resource.data.agencyId)
        && get(/databases/$(db)/documents/properties/$(resource.data.propertyId)).data.agencyId
             == resource.data.agencyId);
      allow create, update, delete: if false;
    }
    match /propertyReadingCounters/{id} {
      allow read, write: if false;
    }

    // ── requests ──
    function from() { return resource.data.status; }
    function to() { return d().status; }

    // sha256 do manifest.json servido no preview: a identidade exata do artefato aprovado
    // (build once, promote the exact artifact). matches() casa a string inteira.
    function isSha256(v) { return v is string && v.matches('[0-9a-f]{64}'); }
    function productionModeOk() {
      return 'productionMode' in d() && d().productionMode in ['leve', 'premium'];
    }

    // M1-E: a leitura fixada como entrada da produção (productionInput). Não é aprovação: aprovar é
    // do build (approvedBuild + manifest). O ponteiro só vale se repetir EXATAMENTE o snapshot
    // imutável de propertyReadings, do imóvel do pedido, da agência do pedido e do imóvel hoje.
    function inputKeys() {
      return ['readingId', 'readingVersion', 'readingRevision', 'schemaVersion', 'contentSha256',
              'fixedBy', 'fixedAt'];
    }
    function inputMatchesReading(pi) {
      let rd = get(/databases/$(db)/documents/propertyReadings/$(pi.readingId)).data;
      return pi.readingId is string && pi.readingId.matches('[A-Za-z0-9_-]{1,128}')
        && 'propertyId' in d() && rd.propertyId == d().propertyId
        && rd.agencyId == resource.data.agencyId
        && get(/databases/$(db)/documents/properties/$(d().propertyId)).data.agencyId
             == resource.data.agencyId
        && pi.readingVersion == rd.version && pi.readingRevision == rd.revision
        && pi.schemaVersion == rd.schemaVersion
        && isSha256(pi.contentSha256) && pi.contentSha256 == rd.contentSha256;
    }
    // Só a equipe, só em accepted/production, sem mudar status/imóvel no mesmo write, e com o
    // AuditLog interno do mesmo batch dizendo de onde para onde o ponteiro foi. O log é imutável e
    // o histórico mostra "v1 → v3" a partir dele: todo campo usado como evidência é conferido, e
    // "não havia entrada" é null explícito (acesso sem default: chave ausente nega).
    function productionInputSet(rid) {
      let pi = d().productionInput;
      let log = getAfter(/databases/$(db)/documents/auditLogs/$(d().lastAuditId)).data;
      let old = resource.data.get('productionInput', {});
      return isStaff() && from() in ['accepted', 'production']
        && !changed('status') && !changed('propertyId')
        && pi.keys().hasOnly(inputKeys()) && pi.keys().hasAll(inputKeys())
        && pi.fixedBy == request.auth.uid && pi.fixedAt == request.time
        && inputMatchesReading(pi)
        && auditedAs(rid, 'production_input:set') && log.visibility == 'internal'
        && log.before.readingId == old.get('readingId', null)
        && log.before.readingVersion == old.get('readingVersion', null)
        && log.before.contentSha256 == old.get('contentSha256', null)
        && log.after.readingId == pi.readingId && log.after.readingVersion == pi.readingVersion
        && log.after.readingRevision == pi.readingRevision
        && log.after.contentSha256 == pi.contentSha256;
    }
    // Fluxo legado: o imóvel ainda é produzido por plantas_fornecidas/<pipelineUnitId>/ (BuildJob
    // de hoje). Ele sai desta exceção quando BuildJob passar a partir do snapshot (M2). Mesmo aqui
    // o imóvel tem que estar hoje na agência do pedido: a invariável do AGENCY_MISMATCH do BuildJob.
    function legacyPipeline() {
      return 'propertyId' in d()
        && legacyProperty(get(/databases/$(db)/documents/properties/$(d().propertyId)).data);
    }
    function legacyProperty(p) {
      return p.agencyId == resource.data.agencyId
        && p.get('pipelineUnitId', '') is string && p.get('pipelineUnitId', '') != '';
    }
    // Iniciar produção no fluxo novo exige a entrada fixada e ainda válida.
    function productionStartOk() {
      return !(from() == 'accepted' && to() == 'production') || legacyPipeline()
        || ('productionInput' in d() && inputMatchesReading(d().productionInput));
    }

    // Ninguém além do gerente escreve a aprovação. Publicar exige o artefato aprovado: o build
    // e o manifest; uma aprovação sem a identidade do manifest não publica.
    function staffEdit() {
      return keeps(['approvedBuild', 'approvedManifestSha256', 'approvedBy', 'approvedAt'])
        && ((isAdmin() && (to() != 'published'
                           || (from() in ['approved', 'published']
                               && resource.data.approvedBuild == resource.data.preview.build
                               && isSha256(resource.data.get('approvedManifestSha256', null))
                               && resource.data.approvedManifestSha256
                                    == resource.data.preview.get('manifestSha256', null))))
          || (isStaff() && !(to() in ['approved', 'published'])));
    }
    function managerDecision() {
      return isManager(resource.data.agencyId) && from() == 'agency_review'
        && ((to() == 'approved'
              && changesOnly(['status', 'approvedBuild', 'approvedManifestSha256', 'approvedBy',
                              'approvedAt', 'updatedAt', 'lastAuditId'])
              && d().approvedBuild == resource.data.preview.build
              && isSha256(d().get('approvedManifestSha256', null))
              && d().approvedManifestSha256 == resource.data.preview.get('manifestSha256', null)
              && d().approvedBy == request.auth.uid
              && d().approvedAt == request.time)
          // pedir revisão: volta para a revisão interna (M2), ou para a produção (painel de hoje)
          || (to() in ['internal_review', 'production'] && changesOnly(['status', 'updatedAt', 'lastAuditId'])));
    }
    // O robô só anda por estes caminhos (m2-worker.md §1.2), e sempre mudando o status: prévia pronta
    // vai direto à imobiliária (construtora passa pela revisão interna), o aprovado vai ao ar, e o
    // portão que falha leva à revisão interna. Aprovar continua só do gerente (managerDecision), e
    // publicar só sai de approved (staffEdit). Reverter também não é dele: no imóvel, ele só publica.
    function workerRequestOk() {
      return !isWorker()
        || (changed('status')
            && ((to() == 'internal_review' && from() in ['production', 'approved'])
              || (to() == 'agency_review' && from() == 'production'
                  && get(/databases/$(db)/documents/agencies/$(resource.data.agencyId)).data
                       .get('kind', 'imobiliaria') == 'imobiliaria')
              || to() == 'published'));
    }
    function requesterEdit() {
      return inAgency(resource.data.agencyId)
        && (role() == 'agency_manager' || request.auth.uid == resource.data.requestedBy)
        && from() in ['submitted', 'waiting_materials']
        && to() in [from(), 'submitted', 'cancelled']
        && changesOnly(['title', 'notes', 'listingUrl', 'status', 'updatedAt', 'lastAuditId']);
    }

    match /requests/{rid} {
      allow read: if isStaff() || inAgency(resource.data.agencyId);

      allow create: if (isStaff() || inAgency(d().agencyId)) && !isWorker()
        && d().requestedBy == request.auth.uid
        && d().status == 'submitted' && born()
        && productionModeOk()
        && (!('propertyId' in d())
            || get(/databases/$(db)/documents/properties/$(d().propertyId)).data.agencyId
                 == d().agencyId)
        && d().keys().hasOnly(['agencyId', 'requestedBy', 'propertyId', 'listingUrl', 'title',
                               'productionMode', 'status', 'priority', 'notes', 'createdAt', 'updatedAt']);

      allow update: if keeps(['agencyId', 'requestedBy', 'productionMode', 'createdAt']) && stamped()
        && workerRequestOk()
        && (!changed('status') || auditedAs(rid, 'status:' + to()))
        // trocar o preview tira o pedido de approved: a aprovação é de um build
        && (!changed('preview') || !(to() in ['approved', 'published']))
        // o imóvel vinculado é sempre da imobiliária do pedido, na criação e em toda troca
        && (!changed('propertyId') || !('propertyId' in d())
            || get(/databases/$(db)/documents/properties/$(d().propertyId)).data.agencyId
                 == resource.data.agencyId)
        // o primeiro build de revisão amarra o pedido à unidade: depois dele, propertyId não muda
        // (para ninguém, nem platform_admin), e o preview só é trocado, nunca removido
        && (!changed('propertyId') || !('preview' in resource.data))
        // a entrada fixada é do imóvel do pedido: fixou, o imóvel não muda mais
        && (!changed('propertyId') || !('productionInput' in resource.data))
        && (!changed('productionInput') || productionInputSet(rid))
        && productionStartOk()
        && (!changed('preview') || 'preview' in d())
        // todo preview que entra traz a identidade exata do manifest que foi servido
        && (!changed('preview') || isSha256(d().preview.get('manifestSha256', null)))
        && (to() != 'agency_review'
            || (d().preview.build is string && isSha256(d().preview.get('manifestSha256', null))))
        && (staffEdit() || managerDecision() || requesterEdit());
      allow delete: if false;

      match /internal/{doc} {
        allow read, write: if isStaff();
      }
    }

    // ── requestAssets ──
    match /requestAssets/{aid} {
      allow read: if isStaff() || inAgency(resource.data.agencyId);
      allow create: if (isStaff() || inAgency(d().agencyId))
        && d().uploadedBy == request.auth.uid && d().createdAt == request.time
        && get(/databases/$(db)/documents/requests/$(d().requestId)).data.agencyId
             == d().agencyId
        && d().storagePath == 'request-assets/' + d().agencyId + '/' + d().requestId
                              + '/' + d().filename
        && d().type in ['photo', 'video', 'floorplan', 'document', 'reference', 'other']
        && d().keys().hasOnly(['requestId', 'agencyId', 'type', 'filename', 'storagePath',
                               'uploadedBy', 'createdAt']);
      allow update: if false;
      allow delete: if isStaff();
    }

    // ── auditLogs (só cresce) ──
    // Pedido de trabalho para o robô (worker:*, m2-worker.md §3): só a equipe e sempre interno;
    // reverter, só o admin. O robô confere tudo de novo do lado dele.
    function workerCommandOk() {
      let a = d().get('action', null);
      return !(a is string && a.matches('worker:.*'))
        || (isStaff() && d().visibility == 'internal' && (a != 'worker:reverter' || isAdmin()));
    }
    match /auditLogs/{id} {
      allow read: if isStaff()
        || (inAgency(resource.data.agencyId) && resource.data.visibility == 'agency');
      allow create: if active()
        && d().userId == request.auth.uid && d().timestamp == request.time
        && d().visibility in ['internal', 'agency']
        && (isStaff() || (inAgency(d().agencyId) && d().visibility == 'agency'))
        && workerCommandOk();
      allow update, delete: if false;
    }

    // ── publications (histórico de publicar/reverter; só cresce) ──
    // Só nasce junto com a mudança do imóvel que aponta para ela (lastPublicationId).
    function publicationBorn(pubId) {
      let p = getAfter(/databases/$(db)/documents/properties/$(d().propertyId)).data;
      return p.lastPublicationId == pubId && p.agencyId == d().agencyId
        && p.publishedBuild == d().build
        && d().get('requestId', null) == p.get('publishedRequestId', null);   // o histórico diz o mesmo pedido
    }
    match /publications/{pubId} {
      allow read: if isStaff() || inAgency(resource.data.agencyId);
      allow create: if isAdmin()
        && d().publishedBy == request.auth.uid && d().publishedAt == request.time
        && d().action in ['publish', 'rollback'] && publicationBorn(pubId)
        && d().keys().hasOnly(['propertyId', 'agencyId', 'requestId', 'action', 'build',
                               'previousBuild', 'tourUrl', 'maqueteUrl', 'publishedBy',
                               'publishedAt']);
      allow update, delete: if false;
    }

    // ── buildJobs (Fase 2) ──
    // Só o robô escreve (tools/buildjob.mjs e o M2), com o Admin SDK, que não passa por estas regras.
    match /buildJobs/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ── workerLeases (M2): a trava do robô, um robô por vez (m2-worker.md §5) ──
    // Só o robô escreve, pelo Admin SDK; nem como users/worker pelo cliente.
    match /workerLeases/{id} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
