rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: usuário está autenticado e pertence à imobiliária
    function isMember(imobiliaria_id) {
      return request.auth != null
        && request.auth.token.imobiliaria_id == imobiliaria_id;
    }

    // Helper: usuário é admin da imobiliária
    function isAdmin(imobiliaria_id) {
      return isMember(imobiliaria_id)
        && request.auth.token.role == 'admin';
    }

    // ── IMOBILIÁRIAS ──
    match /imobiliarias/{id} {
      allow read: if isMember(id);
      allow write: if isAdmin(id);
    }

    // ── USUÁRIOS ──
    match /usuarios/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.role == 'admin');
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.auth.uid == uid
            || isAdmin(request.resource.data.imobiliaria_id));
      allow delete: if false;  // desativar, não deletar
    }

    // ── CIDADES ──
    match /cidades/{slug} {
      allow read: if true;  // público
      allow write: if false;  // só admin SDK (pipeline)
    }

    // ── IMÓVEIS ──
    match /imoveis/{id} {
      // Público pode ver imóveis publicados
      allow read: if resource.data.status == 'publicado'
        || isMember(resource.data.imobiliaria_id);

      // Membro pode criar imóveis na sua imobiliária
      allow create: if isMember(request.resource.data.imobiliaria_id)
        && request.resource.data.status in ['rascunho', 'processando'];

      // Membro pode editar imóveis da sua imobiliária
      allow update: if isMember(resource.data.imobiliaria_id);

      // Admin pode deletar
      allow delete: if isAdmin(resource.data.imobiliaria_id);
    }

    // ── ANALYTICS ──
    match /analytics/{id} {
      allow create: if true;  // qualquer um pode registrar evento
      allow read: if request.auth != null
        && request.auth.token.role == 'admin';
      allow update, delete: if false;  // imutável
    }
  }
}
