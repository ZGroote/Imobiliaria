rules_version = '2';
// As primeiras regras reais do Storage (T03; tasks/painel/proposta.md, §5). O bucket ainda
// não existe (D2, 24/09): até ele existir, isto roda só no emulator. Só request-assets/ tem
// bloco; qualquer outro caminho é negado.
service firebase.storage {
  match /b/{bucket}/o {

    // users/{uid} no Firestore é a fonte de papel
    function member() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function activeMember() { return request.auth != null && member().active == true; }
    function staff() { return activeMember() && member().role in ['platform_admin', 'operator']; }
    function ofAgency(a) {
      return activeMember() && member().role in ['agency_manager', 'agent']
        && member().agencyId == a;
    }

    // Materiais enviados pela imobiliária. Só cria: reenviar é arquivo novo.
    // `resource == null`: o Storage avalia SOBRESCREVER como create, não como update
    // (medido no emulator), então `allow update: if false` sozinho não barra.
    match /request-assets/{agencyId}/{requestId}/{file} {
      allow read: if staff() || ofAgency(agencyId);
      allow create: if resource == null && (staff() || ofAgency(agencyId))
        && firestore.get(/databases/(default)/documents/requests/$(requestId)).data.agencyId
             == agencyId
        && request.resource.size < 200 * 1024 * 1024
        && !request.resource.contentType.matches('text/html.*|image/svg.*|application/xhtml.*');
      allow update: if false;
      allow delete: if staff();
    }
  }
}
