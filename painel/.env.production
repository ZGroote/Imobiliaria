# next build: projeto real imobilaria-deccb, app web "painel" (firebase apps:sdkconfig WEB).
# Configuração PÚBLICA por natureza: vai no bundle de qualquer app web do Firebase. Quem protege
# o dado são as Security Rules. Nenhum segredo administrativo (service account) entra aqui.
NEXT_PUBLIC_FIREBASE_EMULATOR=0
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCBhpvOAOlZ6PD-jYWKRTn4xVM10e00oy4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=imobilaria-deccb.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=imobilaria-deccb
NEXT_PUBLIC_FIREBASE_APP_ID=1:163406298617:web:a78e1724d239a144f55128
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=imobilaria-deccb.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=163406298617
# Site de imóveis (Trilho B): o painel lê o estado.json dele para conferir e registrar publicação e
# reversão. O CORS do site (firebase.imoveis.json) libera só a origem do painel.
NEXT_PUBLIC_SITE_IMOVEIS=https://imobilaria-deccb-imoveis.web.app
